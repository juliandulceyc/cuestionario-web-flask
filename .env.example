# CONFIGURACIÓN DE SEGURIDAD - NO SUBIR A GIT
# Agregar este archivo a .gitignore

# Base de datos
DATABASE_URL=postgresql://empresa_user:qwerty@localhost:5432/empresa_db

# Claves secretas (CAMBIAR EN PRODUCCIÓN)
SECRET_KEY=tu_clave_secreta_super_segura_cambiar_en_produccion_12345
JWT_SECRET_KEY=tu_jwt_secret_key_super_segura_cambiar_en_produccion_67890

# Credenciales de administrador
ADMIN_USER=admin
ADMIN_PASS=123456

# Configuración de Flask
FLASK_DEBUG=True
PORT=5000

# Configuración de tokens
TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Email para recuperación de contraseñas (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_de_aplicacion
EMAIL_FROM=noreply@tuempresa.com
ADMIN_EMAIL=admin@tuempresa.com
